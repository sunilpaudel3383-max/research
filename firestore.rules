rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isMemberOf(groupId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /admins/{uid} {
      allow read: if isAuthenticated();
      // Allow the very first admin to claim the role
      allow write: if isAuthenticated() && (isAdmin() || !exists(/databases/$(database)/documents/admins/$(uid)));
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAdmin() || isMemberOf(groupId);
      allow write: if isAdmin();
      
      match /literatures/{litId} {
        allow read, create: if isAdmin() || isMemberOf(groupId);
        allow update: if isAdmin() || (isMemberOf(groupId) && resource.data.uploadedBy == request.auth.uid);
        allow delete: if isAdmin() || (isMemberOf(groupId) && resource.data.uploadedBy == request.auth.uid);
      }
    }

    match /manuscripts/{groupId} {
      allow read, write: if isAdmin() || isMemberOf(groupId);
    }
  }
}
